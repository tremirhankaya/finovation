# Public host and TLS certificate notifications
ACME_EMAIL=admin@finovation.com.tr

# SQL Server Express is licensed for production but has product limits.
MSSQL_PID=Express
MSSQL_SA_PASSWORD=replace-with-a-long-random-password
MSSQL_MEMORY_LIMIT_MB=4096
DB_NAME=finovation

# Application secrets. JWT_SECRET must be Base64 encoded.
JWT_SECRET=replace-with-base64-secret
PASSWORD_RESET_SECRET=replace-with-another-base64-secret
AI_ENGINE_API_KEY=replace-with-a-long-random-api-key

# External Infina service
INFINA_BASE_URL=https://replace-with-production-infina-url
INFINA_API_KEY=replace-with-production-infina-api-key

# Production must use the real clock.
FINANCIAL_TIME_SIMULATION_ENABLED=false
FINANCIAL_TIME_ZONE=Europe/Istanbul
MARKETDATA_SYNC_ENABLED=false
MARKETDATA_BOOTSTRAP_ON_STARTUP=false

# Password reset email delivery
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_FROM=noreply@finovation.com.tr

# Only required when starting with --profile monitoring.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
