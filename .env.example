# Copy this file to .env in the Finovation repository root.
# Keep .env local and never commit real secrets.

MSSQL_SA_PASSWORD=
DB_NAME=finovation

# Infina market data API.
INFINA_BASE_URL=
INFINA_API_KEY=

# Fund creation limits.
FUND_MIN_INITIAL_PORTFOLIO_SIZE=1000000
FUND_MAX_INITIAL_PORTFOLIO_SIZE=100000000000

# Market data synchronization.
MARKETDATA_REFERENCE_SYNC_CRON="0 0 7 * * *"
MARKETDATA_PRICE_SYNC_CRON="0 30 9,19 * * *"
MARKETDATA_PRICE_DEEP_REFRESH_CRON="0 0 4 * * SUN"
MARKETDATA_PRICE_LOOKBACK_DAYS=30
MARKETDATA_PRICE_DEEP_LOOKBACK_DAYS=365
MARKETDATA_HISTORY_START=1990-01-01
MARKETDATA_BOOTSTRAP_ON_STARTUP=true

# Base64-encoded secret with at least 32 random bytes for HS256.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=15h

# Password reset OTP settings. PASSWORD_RESET_SECRET falls back to JWT_SECRET.
PASSWORD_RESET_SECRET=
PASSWORD_RESET_OTP_EXPIRATION=10m
PASSWORD_RESET_TOKEN_EXPIRATION=10m
PASSWORD_RESET_RESEND_COOLDOWN=1m
PASSWORD_RESET_MAX_ATTEMPTS=5

# Login brute-force protection (per IP).
LOGIN_RATE_LIMIT_WINDOW=1m
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Password reset IP-based rate limits (on top of the per-email limits above).
PASSWORD_RESET_REQUEST_IP_WINDOW=1m
PASSWORD_RESET_REQUEST_IP_MAX_ATTEMPTS=5
PASSWORD_RESET_VERIFY_IP_WINDOW=1m
PASSWORD_RESET_VERIFY_IP_MAX_ATTEMPTS=10

# Refresh token soft rate limit (per IP).
REFRESH_RATE_LIMIT_WINDOW=1m
REFRESH_RATE_LIMIT_MAX_ATTEMPTS=30

# Gmail SMTP. Use a dedicated test account and a Google App Password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_FROM=

# Grafana local administrator account.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
